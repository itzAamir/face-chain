APP_PORT=8000
LOG_LEVEL=INFO
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-credentials.json
SERPAPI_API_KEY=
FACE_DETECTION_THRESHOLD=0.9
CANDIDATE_FACE_DETECTION_THRESHOLD=0.65
FACE_MATCH_THRESHOLD=0.363
MAX_IMAGE_PIXELS=24000000
SEARCH_CANDIDATE_LIMIT=80
SEARCH_RESULT_LIMIT=5
SEARCH_IMAGES_PER_PAGE=4
MAX_CANDIDATE_PAGE_BYTES=2097152
SEARCH_PROVIDER_TIMEOUT_SECONDS=25
CANDIDATE_DOWNLOAD_TIMEOUT_SECONDS=10
SERPAPI_TIMEOUT_SECONDS=45

# Set to false to run the chain stack without recording attestations.
EVIDENCE_ATTEST=true

# Retain the exact matched image bytes alongside each record.
EVIDENCE_STORE_IMAGES=false

# Blockchain client. ATTESTER_ADDRESS is optional: the local Hardhat node
# exposes unlocked accounts, and the first one is used when this is unset.
BLOCKCHAIN_TIMEOUT_SECONDS=10
BLOCKCHAIN_RECEIPT_ATTEMPTS=20
BLOCKCHAIN_RECEIPT_INTERVAL_SECONDS=0.25
ATTESTER_ADDRESS=
